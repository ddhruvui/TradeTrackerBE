{
  "name": "trade-tracker-be",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for Trade Tracker: trades, exits and realized-profit totals.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nodemon --quiet --watch server --watch .env server/index.js",
    "dev:test": "TEST_DB=true nodemon --quiet --watch server --watch .env server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "test": "TEST_DB=true node --test --test-reporter=spec --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
