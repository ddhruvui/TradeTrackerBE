# Copy to .env and fill in. .env is git-ignored.

# Atlas connection string. A <db_password> placeholder is filled from DB_PASSWORD.
MONGO_URI=mongodb+srv://USER:<db_password>@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_PASSWORD=

# Real (prod) database
MONGO_DB=
# Test database. Must differ from MONGO_DB. npm test always uses it and clears it.
MONGO_DB_Test=

# true = the app uses MONGO_DB_Test, false = MONGO_DB. The API restarts when you change it.
TEST_DB=false

# Brokers: short code → name, as JSON in single quotes. Add, rename or remove freely.
BROKERS='{"R":"Robinhood","V":"Vanguard","ML":"Merrill Lynch"}'
# Picked for new transactions. Optional: without it the first broker is the default.
DEFAULT_BROKER=R

# Deployed only: sites whose browsers may call the API, comma-separated.
# CORS_ORIGINS=https://trade-tracker-fe.onrender.com

# Optional
# API_PORT=4000
# HOST=127.0.0.1
